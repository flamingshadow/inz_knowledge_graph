# Copy to .env and fill in. Never commit .env.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=localdevpassword
NEO4J_DATABASE=neo4j
# Read-only account for the assistant and query API (give it the "reader" role on
# Neo4j Enterprise or Aura). Leave unset or blank to use the account above.
# NEO4J_READER_USER=
# NEO4J_READER_PASSWORD=

# Staff chat assistant
ANTHROPIC_API_KEY=
INZKG_MODEL=claude-opus-5-5
INZKG_EFFORT=medium
INZKG_CHAT_LOG_DIR=logs
